# Copier ce fichier en .env puis adapter les valeurs.
# NE JAMAIS committer le fichier .env réel.

# Connexion PostgreSQL (source de vérité de toutes les données).
# Développement local : base fournie par docker-compose.yml (service db, port hôte 5434).
DATABASE_URL="postgresql://jeux_user:CHANGE_ME@localhost:5434/jeux_multiplication?schema=public"

# Base PostgreSQL de TEST isolée (tests d'intégration Vitest).
# Provisionnement : npm run db:test:setup
TEST_DATABASE_URL="postgresql://jeux_user:CHANGE_ME@localhost:5434/jeux_multiplication_test?schema=public"

# Secret de signature des JWT de session (HS256).
# 32 caractères minimum. Génération :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Durée de vie d'une session, en heures (défaut : 72).
AUTH_SESSION_HOURS=72

# Coût bcrypt, entre 10 et 15 (défaut : 12).
AUTH_BCRYPT_ROUNDS=12

# Limitation des tentatives de connexion :
# échecs comptés sur une fenêtre glissante de AUTH_ATTEMPT_WINDOW_MIN minutes ;
# au AUTH_MAX_LOGIN_ATTEMPTS-ème échec, blocage de AUTH_BLOCK_MINUTES minutes ;
# tentatives purgées après AUTH_ATTEMPT_RETENTION_HOURS heures.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_ATTEMPT_WINDOW_MIN=15
AUTH_BLOCK_MINUTES=15
AUTH_ATTEMPT_RETENTION_HOURS=24

# Environnement d'exécution (development | production).
NODE_ENV="development"

# ------------------------------------------------------------------
# Assistant d'installation (voir docs/INSTALLATION.md)
# ------------------------------------------------------------------

# Jeton d'installation : protège l'assistant /installation tant que
# l'application n'est pas installée. En Docker, s'il est vide, le
# conteneur en génère un au démarrage et l'imprime dans ses journaux
# (docker compose logs app). Laisser vide sauf besoin explicite.
INSTALL_TOKEN=""

# Jeton de récupération administrateur (page /recuperation-admin).
# VIDE = mécanisme désactivé. Génération : même commande que AUTH_SECRET.
# À définir UNIQUEMENT sur le serveur, jamais commité.
ADMIN_RECOVERY_TOKEN=""

# Limite du pool de connexions PostgreSQL (serverless : 1-5 ;
# conteneur dédié : laisser vide pour le défaut).
# PGPOOL_MAX=3

